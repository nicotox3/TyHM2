{UTF-8}
BRECHA=INVENTARIO DESEADO-INVENTARIO
	~	WIDGETS
	~		|

EMPLEO= INTEG (VARIACION NETA EN EL EMPLEO,
		EMPLEO INICIAL)
	~	PERSONAS
	~		|

EMPLEO INICIAL=200
	~	PERSONAS
	~		|

INVENTARIO= INTEG (PRODUCCION MENOS VENTAS,
		INVENTARIO INICIAL)
	~	WIDGETS
	~		|

INVENTARIO DESEADO=20000
	~	WIDGETS
	~		|

INVENTARIO INICIAL=25000
	~	WIDGETS
	~		|

NUMERO DE PERSONAS QUE SE NECESITAN CONTRATAR=PRODUCCION NECESARIA PARA CERRAR BRECHA\
		/PRODUCTIVIDAD
	~	PERSONAS
	~		|

PRODUCCION MENOS VENTAS=(EMPLEO*PRODUCTIVIDAD)-VENTAS
	~	WIDGETS/AÑO
	~		|

PRODUCCION NECESARIA PARA CERRAR BRECHA=BRECHA/TIEMPO DE CIERRE BRECHA DE INVENTARIO
	~	
	~		|

PRODUCTIVIDAD=100
	~	WIDGETS/(PERSONAS*AÑO)
	~		|

RETRASO EN LA CONTRATACION=0.25
	~	AÑO
	~		|

TIEMPO DE CIERRE BRECHA DE INVENTARIO=0.5
	~	AÑO
	~		|

VARIACION NETA EN EL EMPLEO=NUMERO DE PERSONAS QUE SE NECESITAN CONTRATAR/RETRASO EN LA CONTRATACION
	~	PERSONAS/AÑO
	~		|

VENTAS=20000
	~	WIDGETS/AÑO
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 10
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP 
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.0625
	~	Year [0,?]
	~	The time step for the simulation.
	|

